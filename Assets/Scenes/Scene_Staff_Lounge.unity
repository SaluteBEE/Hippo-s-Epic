      propertyPath: phases.Array.data[2].hintText
      value: "\u955C\u5B50\u8F93\u4E86\uFF0C\u5B83\u5F7B\u5E95\u6E83\u8D25\u4E86\uFF0C\u4F60\u5728\u8FD9\u573A\u9B44\u529B\u6BD4\u62FC\u4E2D\u5F7B\u5F7B\u5E95\u5E95\u7684\u51FB\u57AE\u4E86\u5B83\u7684\u4E00\u5207\u9632\u7EBF\u3002"
