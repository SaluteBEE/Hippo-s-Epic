      value: "\u4E00\u4E2A\u5BFB\u5E38\u7684\u5395\u6240\uFF0C\u6216\u8BB8\u5728\u4F60\u7528\u5B83\u4E4B\u524D\u8FD9\u53EA\u4F1A\u662F\u5BFB\u5E38\u7684\u4E00\u5929\uFF0C\u4F46\u662F\u5728\u4F60\u53D1\u73B0\u6CA1\u6709\u536B\u751F\u7EB8\u4E4B\u540E\u4E00\u5207\u90FD\u665A\u4E86\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 4157385159750846353, guid: 0b5aa9fbd5f4a5e4da770a37602b9c3c, type: 3}
      propertyPath: phases.Array.data[1].hintText
      value: "\u4F60\u786E\u5B9A\u5417\uFF0C\u771F\u7684\u8981\u628A\u6240\u6709\u4E8B\u60C5\u90FD\u641E\u5F97\u8FD9\u4E48\u60CA\u4E16\u9A87\u4FD7\u4E48\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 4157385159750846353, guid: 0b5aa9fbd5f4a5e4da770a37602b9c3c, type: 3}
      propertyPath: phases.Array.data[2].hintText
      value: "\u597D\u5427\uFF0C\u6216\u8BB8\u5B83\u53EA\u662F\u4E00\u4E2A\u666E\u901A\u7684\u51B0\u6DC7\u6DCB\u5C0F\u5C4B\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 4157385159750846353, guid: 0b5aa9fbd5f4a5e4da770a37602b9c3c, type: 3}
      propertyPath: phases.Array.data[3].hintText
      value: "\u4F60\u8BD5\u56FE\u901A\u8FC7\u628A\u9A6C\u6876\u91CC\u7684\u94A5\u5319\u5939\u51FA\u6765\u6574\u7406\u8FD9\u4E2A\u7CDF\u7CD5\u7684\u5395\u6240\uFF0C\u53EF\u8FD9\u91CC\u9762\u7684\u60C5\u666F\u4F9D\u7136\u662F\u7CDF\u7CD5\u7684\u53EF\u6015\uFF0C\u7C97\u7684\uFF0C\u7EC6\u7684\uFF0C\u7A00\u7684\uFF0C\u5E72\u7684\uFF0C\u9EC4\u7684\uFF0C\u9ED1\u7684\uFF0C\u767D\u7684\uFF0C\u867E\u4EC1\uFF0C\u7389\u7C73\u7C92\uFF0C\u82B1\u751F\u7C73\uFF0C\u674F\u4EC1\u6838\uFF0C\u51B0\u6DC7\u51CC\uFF0C\u5E9F\u62A5\u7EB8\uFF0C\u9F3B\u6D95\u56E2\uFF0C\u5934\u53D1\u4E1D\uFF0C\u5564\u9152\u74F6\uFF0C\u73BB\u7483\u78B4\uFF0C\u5455\u5410\u7269\uFF0C\u4EBA\u4F53\u7EC4\u7EC7\uFF0C\u7ED3\u7F14\u7EC4\u7EC7\uFF0C\u5DE6\u8111\u534A\u7403"
      objectReference: {fileID: 0}
    - target: {fileID: 4157385159750846353, guid: 0b5aa9fbd5f4a5e4da770a37602b9c3c, type: 3}
      propertyPath: phases.Array.data[4].hintText
      value: "\u73B0\u5728\u91CC\u9762\u53EA\u5269\u4E0B\u4E86\u7C97\u7684\uFF0C\u7EC6\u7684\uFF0C\u7A00\u7684\uFF0C\u5E72\u7684\uFF0C\u9EC4\u7684\uFF0C\u9ED1\u7684\uFF0C\u767D\u7684\uFF0C\u867E\u4EC1\uFF0C\u7389\u7C73\u7C92\uFF0C\u82B1\u751F\u7C73\uFF0C\u674F\u4EC1\u6838\uFF0C\u51B0\u6DC7\u51CC\uFF0C\u5E9F\u62A5\u7EB8\uFF0C\u9F3B\u6D95\u56E2\uFF0C\u5934\u53D1\u4E1D\uFF0C\u5564\u9152\u74F6\uFF0C\u73BB\u7483\u78B4\uFF0C\u5455\u5410\u7269\uFF0C\u4EBA\u4F53\u7EC4\u7EC7\uFF0C\u7ED3\u7F14\u7EC4\u7EC7\uFF0C\u5DE6\u8111\u534A\u7403"
