@startuml battle_activity
' 战斗系统活动图 - 回合循环（含表现层演出 + 行动点）
skinparam defaultFontName "Noto Sans CJK SC"
skinparam activityFontSize 12
skinparam activityDiamondFontSize 12

title 战斗回合循环活动图（含前端表现 + 行动点）

start
:GameApp.EnterBattle(battleId);
:InitBattle → LoadScene(Scene_Battle);
:打开 BattleWindow (onReady 回调, 先开窗+订阅15事件);
:StageManager.SpawnUnits (Addressables 生成 Spine 角色 + 血条);
:StartBattle (全局 Buff + OnBattleStart → 事件必达);

repeat
  :StartRound;
  :处理召唤事件 / RoundStart 事件 / 全局 TurnStart Buff;
  :按 FinalSpeed 降序排序 → 建 TurnQueue;
  repeat
    :StartUnitTurn (TurnStart 事件/Buff;\n行动点重置 = Stats.ActionPoint 默认2);
    :ProcessStatusCheck (眩晕/冻结 → 跳过行动);
    if (单位是玩家控制?) then (是)
      :IsWaitingForPlayerAction = true;
      :UI: 高亮单位 + 显示操作按钮 + 默认选中目标;
      repeat
        :玩家操作 (技能/物品/发呆/逃跑);
        if (选择发呆?) then (是)
          :PlayerDeferTurn → 当前单位排到队尾;
        elseif (选择逃跑?) then (是)
          :ExecuteFlee → EndBattle(Flee);
        elseif (选择技能?) then (是)
          :PlayerUseSkill → 扣 skill.Cost 行动点;
          :ExecuteSkill → QueuePendingHit 暂存伤害\n(不立即扣血);
          :**Presenter.PlaySkillSequence**\n(转身→走向→蓄力→冲刺→命中停顿→\n受击闪白/后仰→[打击时刻] ResolvePendingHits\n真正扣血→喜剧延迟→飘字→归位);
          :CheckDeaths → **DeathRoutine**\n(等演出完→倒地→隐藏);
        else (物品)
          :ExecuteItem (Buff + 背包扣除;\n不扣行动点, 不结束回合);
          :CheckDeaths;
        endif
      repeatwhile (剩余行动点 > 0 且未选发呆/逃跑?)
      :EndUnitTurn (TurnEnd 事件/Buff);
      :AdvanceTurnQueue;
    else (否)
      :BattleAI.Decide → 构造 BattleAction\n(敌人一回合招, 不走行动点);
      :ExecuteAction → ExecuteSkill/普攻\n(QueuePendingHit 暂存 → 演出打击时刻结算);
      :演出序列 + CheckDeaths + DeathRoutine;
      :EndUnitTurn;
      :AdvanceTurnQueue;
    endif
  repeatwhile (TurnQueue 非空?)

  :EndRound (RoundEnd 事件 + 冷却递减);
repeatwhile (双方都有存活单位?)

if (结果?) then (玩家全灭)
  :EndBattle(Lose);
elseif (敌方全灭) then
  :EndBattle(Win) → ApplyBattleRewards;
else (逃跑)
  :EndBattle(Flee);
endif

:BattleWindow.WaitPerformancesThenReturn (等演出全完);
:GameApp.OnBattleResultConfirmed → 返回原场景;
:ExitBattle (清 BattleManager, 恢复状态);

stop
@enduml
