@startuml battle_activity
' 战斗系统活动图 - 回合循环（含表现层演出）
skinparam defaultFontName "Noto Sans CJK SC"
skinparam activityFontSize 12
skinparam activityDiamondFontSize 12

title 战斗回合循环活动图（含前端表现）

start
:GameApp.EnterBattle(battleId);
:InitBattle → LoadScene(Scene_Battle);
:StageManager.SpawnUnits (Addressables 生成 Spine 角色 + 血条);
:StartBattle (全局 Buff + OnBattleStart);
:打开 BattleWindow (订阅事件);

repeat
  :StartRound;
  :处理召唤事件 / RoundStart 事件 / 全局 TurnStart Buff;
  :按 FinalSpeed 降序排序 → 建 TurnQueue;
  repeat
    :StartUnitTurn (TurnStart 事件/Buff);
    :ProcessStatusCheck (眩晕/冻结 → 跳过行动);
    if (单位是玩家控制?) then (是)
      :IsWaitingForPlayerAction = true;
      :UI: 高亮单位 + 显示操作按钮 + 默认选中目标;
      repeat
        :玩家操作 (技能/物品/防御/发呆/逃跑);
      repeatwhile (未选择行动?)
      :PlayerUseSkill/Item/Defend → 构造 BattleAction;
    else (否)
      :BattleAI.Decide → 构造 BattleAction;
    endif

    :ExecuteAction → ResolveTargets;
    if (行动类型?) then (技能)
      :ExecuteSkill (伤害/治疗/Buff 结算 + 事件广播);
      :**Presenter.PlaySkillSequence** (演出序列);
      :转身 → 走向 → 蓄力 → 冲刺 → 命中停顿;
      :受击闪白/后仰 → 喜剧延迟;
      :DamageFx 飘字 + 血条白条残影;
      :归位;
    elseif (物品) then
      :ExecuteItem (Buff + 背包扣除);
    elseif (防御) then
      :ExecuteDefend (IsDefending=true);
    else (逃跑)
      :ExecuteFlee → EndBattle(Flee);
    endif

    if (演出结束回调后) then
      :CheckDeaths;
      if (有单位死亡?) then (是)
        :**DeathRoutine** (等演出完 → 0.45s 倒地 → 隐藏);
      endif
      :EndUnitTurn (TurnEnd 事件/Buff);
      :AdvanceTurnQueue;
    endif
  repeatwhile (TurnQueue 非空?)

  :EndRound (RoundEnd 事件 + 冷却递减);
repeatwhile (双方都有存活单位?)

if (结果?) then (玩家全灭)
  :EndBattle(Lose);
elseif (敌方全灭) then
  :EndBattle(Win) → ApplyBattleRewards;
else (逃跑)
  :EndBattle(Flee);
endif

:BattleWindow.WaitPerformancesThenReturn (等演出全完);
:GameApp.OnBattleResultConfirmed → 返回原场景;
:ExitBattle (清 BattleManager, 恢复状态);

stop
@enduml
